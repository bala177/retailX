# RetailX Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/retailx
MONGODB_TEST_URI=mongodb://localhost:27017/retailx_test

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Refresh Token
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-in-production
REFRESH_TOKEN_EXPIRES_IN=30d

# Password Reset
PASSWORD_RESET_EXPIRES_MINUTES=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Email Configuration (Optional - for password reset, notifications)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@retailx.com

# Platform Configuration
PLATFORM_NAME=RetailX
PLATFORM_URL=http://localhost:5000
ADMIN_URL=http://localhost:3001
STOREFRONT_URL=http://localhost:3000

# Tenant Resolution Mode: subdomain | path | header
TENANT_RESOLUTION_MODE=path

# Default Platform Owner (created during seed)
PLATFORM_OWNER_EMAIL=admin@retailx.com
PLATFORM_OWNER_PASSWORD=Admin@123456

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# Security
BCRYPT_SALT_ROUNDS=12
SESSION_SECRET=your-session-secret-change-in-production

# Redis (Optional - for caching and sessions)
REDIS_URL=redis://localhost:6379

# Cloud Storage (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1

# Payment Gateway Keys (Add as needed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
