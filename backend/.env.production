# Production Environment Variables for Render
# These values will be overridden by Render's environment variables

NODE_ENV=production
PORT=10000

# MongoDB Atlas Connection String (Set in Render Dashboard)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/retailx?retryWrites=true&w=majority

# JWT Configuration (Auto-generated by Render)
# JWT_SECRET=
# REFRESH_TOKEN_SECRET=
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# CORS Origins (Update with your actual Render URLs)
# CORS_ORIGIN=https://retailx-admin.onrender.com,https://retailx-storefront.onrender.com

# Rate Limiting (adjust for production)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=5242880

# API Version
API_VERSION=v1
